 // iteration interval that is used when no call is active
 #define IDLE_ITERATION_INTERVAL_MS 1000
 
+// How long a call's friend connection may report TOX_CONNECTION_NONE before the call is
+// actually torn down. tox_friend_get_connection_status() can flap briefly (DHT/UDP keepalive
+// jitter under the extra bandwidth/CPU load of an active audio/video call) without the peer
+// having genuinely gone away; killing the call on the very first offline observation treated a
+// momentary blip the same as a real disconnect. This grace period lets iterate_common() ride
+// out a brief reconnect instead.
+#define CALL_OFFLINE_GRACE_PERIOD_MS 10000
+
 typedef struct ToxAVCall ToxAVCall;
 
 static ToxAVCall *_Nullable call_get(ToxAV *_Nonnull av, uint32_t friend_number);
