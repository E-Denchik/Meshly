# Gradle
.gradle/
build/

# Local configuration (machine-specific, never shared)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store

# Native build (CMake / NDK)
.cxx/
*.so
*.a

# Scratch clones/build dirs for daemon-tox/scripts/build-native-deps.sh - only the
# resulting headers/pkgconfig/cmake-config metadata under daemon-tox/deps/<abi>/ are
# tracked; the upstream source trees and the .a archives above are rebuilt, not committed.
daemon-tox/deps/.build/

# Logs
*.log

# Unrelated local caches (not part of this project)
npm-cache/

# Keystores (never commit signing keys)
*.jks
*.keystore
